# Example environment variables for release signing (do not commit real secrets).
# Set these in your CI/CD environment or local shell before running assembleRelease.

# Absolute or relative path to your release keystore file
ANDROID_KEYSTORE_PATH=/abs/path/to/keystore.jks

# Keystore password
ANDROID_KEYSTORE_PASSWORD=changeit

# Alias of the key entry in the keystore
ANDROID_KEY_ALIAS=release

# Password for the key alias
ANDROID_KEY_PASSWORD=changeit
